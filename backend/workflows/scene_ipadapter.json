{
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": { "ckpt_name": "AnythingXL_v50.safetensors" }
  },
  "22": {
    "class_type": "LoadImage",
    "inputs": { "image": "{{REF_IMAGE}}", "upload": "image" }
  },
  "30": {
    "class_type": "easy ipadapterApply",
    "inputs": {
      "model": ["1", 0],
      "image": ["22", 0],
      "preset": "PLUS (high strength)",
      "lora_strength": 1.0,
      "provider": "CUDA",
      "weight": 0.7,
      "weight_faceidv2": 1.0,
      "start_at": 0.0,
      "end_at": 1.0,
      "cache_mode": "all",
      "use_tiled": false
    }
  },
  "2": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "{{POSITIVE_PLACEHOLDER}}", "clip": ["1", 1] }
  },
  "3": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "nsfw, lowres, bad anatomy, bad hands, text, watermark, signature, jpeg artifacts, worst quality, blurry, deformed", "clip": ["1", 1] }
  },
  "4": {
    "class_type": "EmptyLatentImage",
    "inputs": { "width": 480, "height": 832, "batch_size": 1 }
  },
  "5": {
    "class_type": "KSampler",
    "inputs": {
      "seed": 0,
      "steps": 26,
      "cfg": 6.0,
      "sampler_name": "dpmpp_2m",
      "scheduler": "karras",
      "denoise": 1.0,
      "model": ["30", 0],
      "positive": ["2", 0],
      "negative": ["3", 0],
      "latent_image": ["4", 0]
    }
  },
  "6": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["5", 0], "vae": ["1", 2] }
  },
  "7": {
    "class_type": "SaveImage",
    "inputs": { "images": ["6", 0], "filename_prefix": "drama_studio/ipa" }
  }
}
