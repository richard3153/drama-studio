{
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": { "ckpt_name": "AnythingXL_v50.safetensors" }
  },
  "2": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "{{POSITIVE_PLACEHOLDER}}", "clip": ["1", 1] }
  },
  "3": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "nsfw, lowres, bad anatomy, bad hands, text, watermark, signature, jpeg artifacts, worst quality, blurry, deformed", "clip": ["1", 1] }
  },
  "8": {
    "class_type": "LoadImage",
    "inputs": { "image": "{{SOURCE_IMAGE}}", "upload": "image" }
  },
  "10": {
    "class_type": "ImageScale",
    "inputs": { "image": ["8", 0], "upscale_method": "lanczos", "width": 480, "height": 832, "crop": "center" }
  },
  "9": {
    "class_type": "VAEEncode",
    "inputs": { "pixels": ["10", 0], "vae": ["1", 2] }
  },
  "5": {
    "class_type": "KSampler",
    "inputs": {
      "seed": 0,
      "steps": 20,
      "cfg": 4.5,
      "sampler_name": "dpmpp_2m",
      "scheduler": "karras",
      "denoise": 0.12,
      "model": ["1", 0],
      "positive": ["2", 0],
      "negative": ["3", 0],
      "latent_image": ["9", 0]
    }
  },
  "6": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["5", 0], "vae": ["1", 2] }
  },
  "7": {
    "class_type": "SaveImage",
    "inputs": { "images": ["6", 0], "filename_prefix": "drama_studio/refine" }
  }
}
