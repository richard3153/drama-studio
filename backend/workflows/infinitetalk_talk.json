{
  "100": {
    "class_type": "WanVideoModelLoader",
    "inputs": {
      "model": "Wan2_1-I2V-14B-480P_fp8_e4m3fn.safetensors",
      "base_precision": "bf16",
      "quantization": "disabled",
      "load_device": "offload_device",
      "lora": ["101", 0],
      "multitalk_model": ["103", 0]
    }
  },
  "101": {
    "class_type": "WanVideoLoraSelect",
    "inputs": {
      "lora": "lightx2v_I2V_14B_480p_cfg_step_distill_rank64_bf16.safetensors",
      "strength": 1.0,
      "merge_loras": false
    }
  },
  "102": {
    "class_type": "LoadWanVideoT5TextEncoder",
    "inputs": {
      "model_name": "umt5-xxl-enc-fp8_e4m3fn.safetensors",
      "precision": "bf16",
      "load_device": "offload_device",
      "quantization": "disabled"
    }
  },
  "103": {
    "class_type": "MultiTalkModelLoader",
    "inputs": {
      "model": "Wan2_1-InfiniteTalk-Single_fp8_e4m3fn_scaled_KJ.safetensors"
    }
  },
  "104": {
    "class_type": "WanVideoTextEncode",
    "inputs": {
      "t5": ["102", 0],
      "positive_prompt": "{{POSITIVE_PLACEHOLDER}}",
      "negative_prompt": "{{NEGATIVE_PLACEHOLDER}}",
      "force_offload": true
    }
  },
  "105": {
    "class_type": "CLIPVisionLoader",
    "inputs": {
      "clip_name": "clip_vision_h.safetensors"
    }
  },
  "106": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "{{START_IMAGE}}",
      "upload": "image"
    }
  },
  "107": {
    "class_type": "WanVideoClipVisionEncode",
    "inputs": {
      "clip_vision": ["105", 0],
      "image_1": ["106", 0],
      "strength_1": 1.0,
      "strength_2": 0.0,
      "crop": "center",
      "combine_embeds": "concat",
      "force_offload": true
    }
  },
  "108": {
    "class_type": "WanVideoVAELoader",
    "inputs": {
      "model_name": "wan_2.1_vae.safetensors",
      "precision": "bf16"
    }
  },
  "109": {
    "class_type": "LoadAudio",
    "inputs": {
      "audio": "{{AUDIO}}"
    }
  },
  "110": {
    "class_type": "Wav2VecModelLoader",
    "inputs": {
      "model": "chinese-wav2vec2-base.pt",
      "base_precision": "fp16",
      "load_device": "offload_device"
    }
  },
  "111": {
    "class_type": "MultiTalkWav2VecEmbeds",
    "inputs": {
      "wav2vec_model": ["110", 0],
      "audio_1": ["109", 0],
      "normalize_loudness": true,
      "num_frames": 81,
      "fps": 16.0,
      "audio_scale": 1.0,
      "audio_cfg_scale": 1.0,
      "multi_audio_type": "para"
    }
  },
  "112": {
    "class_type": "WanVideoImageToVideoMultiTalk",
    "inputs": {
      "vae": ["108", 0],
      "width": 480,
      "height": 832,
      "frame_window_size": 49,
      "motion_frame": 25,
      "force_offload": true,
      "colormatch": "disabled",
      "start_image": ["106", 0],
      "clip_embeds": ["107", 0],
      "mode": "infinitetalk",
      "tiled_vae": true
    }
  },
  "113": {
    "class_type": "WanVideoSampler",
    "inputs": {
      "model": ["121", 0],
      "image_embeds": ["112", 0],
      "text_embeds": ["104", 0],
      "multitalk_embeds": ["111", 0],
      "steps": 4,
      "cfg": 1.0,
      "shift": 8.0,
      "seed": 0,
      "force_offload": true,
      "scheduler": "multitalk",
      "riflex_freq_index": 0
    }
  },
  "114": {
    "class_type": "WanVideoDecode",
    "inputs": {
      "vae": ["108", 0],
      "samples": ["113", 0],
      "enable_vae_tiling": true,
      "tile_x": 480,
      "tile_y": 832,
      "tile_stride_x": 320,
      "tile_stride_y": 512
    }
  },
  "120": {
    "class_type": "WanVideoBlockSwap",
    "inputs": {
      "blocks_to_swap": 30,
      "offload_img_emb": true,
      "offload_txt_emb": true
    }
  },
  "121": {
    "class_type": "WanVideoSetBlockSwap",
    "inputs": {
      "model": ["100", 0],
      "block_swap_args": ["120", 0]
    }
  },
  "115": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": ["114", 0],
      "fps": 16
    }
  },
  "116": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": ["115", 0],
      "filename_prefix": "drama_studio/talk",
      "format": "auto",
      "codec": "auto"
    }
  }
}




