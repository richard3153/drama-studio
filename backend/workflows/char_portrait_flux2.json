{
  "1": {
    "class_type": "UNETLoader",
    "inputs": { "unet_name": "flux-2-klein-4b-fp8.safetensors", "weight_dtype": "default" }
  },
  "2": {
    "class_type": "CLIPLoader",
    "inputs": { "clip_name": "qwen_3_4b.safetensors", "type": "flux2", "device": "default" }
  },
  "3": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "flux2-vae.safetensors" }
  },
  "20": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "{{POSITIVE_PLACEHOLDER}}", "clip": ["2", 0] }
  },
  "21": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "{{NEGATIVE_PLACEHOLDER}}", "clip": ["2", 0] }
  },
  "4": {
    "class_type": "EmptyFlux2LatentImage",
    "inputs": { "width": 832, "height": 1216, "batch_size": 1 }
  },
  "5": {
    "class_type": "Flux2Scheduler",
    "inputs": { "steps": 20, "width": 832, "height": 1216 }
  },
  "6": {
    "class_type": "KSampler",
    "inputs": {
      "seed": 0,
      "steps": 20,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1.0,
      "model": ["1", 0],
      "positive": ["20", 0],
      "negative": ["21", 0],
      "latent_image": ["4", 0]
    }
  },
  "7": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["6", 0], "vae": ["3", 0] }
  },
  "8": {
    "class_type": "SaveImage",
    "inputs": { "images": ["7", 0], "filename_prefix": "drama_studio/flux2" }
  }
}
